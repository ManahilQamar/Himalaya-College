# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas (free tier) or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/himalaya_college

# The exact address of the website (comma separated if more than one), for example https://www.yourcollege.edu.pk
CLIENT_ORIGIN=http://localhost:5173

# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How many proxies sit between the visitor and this server. 1 for most hosts.
# Use 2 for the recommended setup (Vercel in front of Render). Check the Activity log in the admin panel:
# if every sign-in shows the same IP address, this number is too low.
TRUST_PROXY=1

# lax (default) is right when the website and API share one address through the /api rewrite.
# Only use "none" if the API lives on a completely different site; Safari may then block the admin login.
COOKIE_SAMESITE=lax
