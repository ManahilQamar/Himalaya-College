# Address of the API. "/api" means "same address as the website": in development Vite forwards it to
# http://localhost:5000, in production the rewrite in vercel.json forwards it to your API server.
# Leave EMPTY to run the website alone with built-in placeholder content (forms are not saved).
VITE_API_URL=/api
VITE_SITE_URL=http://localhost:5173
